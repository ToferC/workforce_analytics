# Copy this file to secrets.yaml and replace placeholder values with real secrets.
# NEVER commit secrets.yaml to version control.
apiVersion: v1
kind: Secret
metadata:
  name: epicenter-db-secrets
  namespace: epicenter
type: Opaque
data:
  POSTGRES_USER: CHANGE_ME_BASE64
  POSTGRES_PASSWORD: CHANGE_ME_BASE64
  POSTGRES_DB: CHANGE_ME_BASE64
---
apiVersion: v1
kind: Secret
metadata:
  name: epicenter-server-secrets
  namespace: epicenter
type: Opaque
data:
  DATABASE_URL: CHANGE_ME_BASE64
  SECRET_KEY: CHANGE_ME_BASE64
  PASSWORD_SECRET_KEY: CHANGE_ME_BASE64
  JWT_SECRET_KEY: CHANGE_ME_BASE64
  ADMIN_EMAIL: CHANGE_ME_BASE64
  ADMIN_PASSWORD: CHANGE_ME_BASE64
  ADMIN_NAME: CHANGE_ME_BASE64
