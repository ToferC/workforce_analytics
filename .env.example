# People Data Analytics (graphql_api) — environment variables.
# Copy to `.env` and fill in real values. `.env` is git-ignored.
#
# Format key:
#   (required)            read at startup; the process panics if missing
#   (required if prod)    required only when ENVIRONMENT=production
#   (optional, default X) falls back to X when unset

# ── Database ────────────────────────────────────────────────────────────────
# (required) PostgreSQL connection string (Diesel). Add ?sslmode=require for
# managed/cloud Postgres; use ?sslmode=disable only for local/dev.
DATABASE_URL=postgres://christopherallison:12345@localhost/workforce_analytics?sslmode=disable

# ── Secrets ─────────────────────────────────────────────────────────────────
# (required) Checked for presence at startup. Use a long random string.
#   e.g. `openssl rand -hex 32`
SECRET_KEY=change-me-32-bytes-minimum-random

# (required) HMAC secret used to sign/verify JWTs (HS256). Use a long random
# value (>= 32 bytes recommended). Rotating it invalidates all issued tokens.
#   e.g. `openssl rand -hex 32`
JWT_SECRET_KEY=change-me-32-bytes-minimum-random

# ── Bootstrap admin (created on first run if absent) ────────────────────────
# (required) All three are read at startup to seed the initial admin user.
ADMIN_NAME=Admin Name
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

# ── Server / networking ─────────────────────────────────────────────────────
# (optional, default "test") Set to "production" to bind to HOST:PORT below.
# Any other value (or unset) binds to 0.0.0.0:8080.
ENVIRONMENT=test

# (required if prod) Bind address and port. Ignored unless ENVIRONMENT=production.
HOST=0.0.0.0
PORT=8080

# (optional, default "http://localhost:3000,http://localhost:8080")
# Comma-separated list of allowed CORS origins (exact match, trimmed).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ── Authorization ───────────────────────────────────────────────────────────
# (optional) Set to "true" or "1" to fall back to flat operator+ authority and
# bypass hierarchy-scoped checks (grandfather window while ownership data is
# populated). Leave unset to enforce scoped authorization (default).
# DISABLE_SCOPED_AUTHZ=true

# ── Kafka (NOT ACTIVE) ──────────────────────────────────────────────────────
# The kafka module is currently disabled in src/lib.rs, so these are read only
# if it is re-enabled. Listed here for completeness.
# BOOTSTRAP_SERVERS=
# SECURITY_PROTOCOL=
# SASL_MECHANISMS=
# SASL_USERNAME=
# SASL_PASSWORD=
