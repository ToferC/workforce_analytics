# syntax=docker/dockerfile:1
#
# Simplest single-stage build: copy the whole workspace, build, and run the
# release binary in place. Largest image; useful for quick local builds.
# Build context is the repository root.

FROM rust:latest AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev \
    libssl-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy everything (see .dockerignore for exclusions). The binary resolves
# templates/static/seeds relative to this working dir at runtime, so running
# from /app keeps those paths valid.
COPY . .

RUN cargo build --release --bin graphql_api

EXPOSE 8080

CMD ["./target/release/graphql_api"]
