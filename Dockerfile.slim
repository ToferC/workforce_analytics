# syntax=docker/dockerfile:1
#
# Recommended production image (smallest). Multi-stage build of the
# `graphql_api` workspace binary onto a slim Debian runtime.
#
# Build context is the repository root (a Cargo workspace: members
# `graphql_api` and `errors`). Selected in docker-compose.yml.

# ---- Build stage ------------------------------------------------------------
FROM rust:latest AS builder

# libpq for Diesel (Postgres), libssl for TLS. pkg-config to locate them.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev \
    libssl-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Whole workspace. All member manifests must be present for cargo to resolve
# the workspace, and `embed_migrations!()` reads ./migrations at build time
# (it walks up from the crate dir to the workspace root).
COPY Cargo.toml Cargo.lock ./
COPY graphql_api graphql_api
COPY errors errors
COPY migrations migrations

RUN cargo build --release --bin graphql_api

# ---- Runtime stage ----------------------------------------------------------
FROM debian:bookworm-slim

# Runtime shared libs only: Postgres client, OpenSSL, CA roots for outbound TLS.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libpq5 \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

# Run as an unprivileged user.
RUN groupadd -r app && useradd --no-log-init -r -g app app

WORKDIR /app

# Binary.
COPY --from=builder /app/target/release/graphql_api ./graphql_api

# Runtime assets, placed at the paths the binary resolves them from:
#   - Tera templates : "graphql_api/templates/**/*"   (relative to CWD = /app)
#   - Static files   : <CARGO_MANIFEST_DIR>/static = /app/graphql_api/static
#   - Seed CSVs      : "seeds/*"                      (relative to CWD = /app)
COPY graphql_api/templates graphql_api/templates
COPY graphql_api/static graphql_api/static
COPY seeds seeds

USER app
EXPOSE 8080

CMD ["./graphql_api"]
