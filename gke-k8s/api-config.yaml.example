# Copy this file to api-config.yaml and replace placeholder values.
# NEVER commit api-config.yaml to version control.
apiVersion: v1
kind: ConfigMap
metadata:
  name: api-configmap
data:
  HOST: "0.0.0.0"
  PORT: "8080"
  DATABASE_URL: "postgres://CHANGE_ME:CHANGE_ME@postgres-service/workforce_analytics?sslmode=disable"
  SECRET_KEY: "CHANGE_ME"
  PASSWORD_SECRET_KEY: "CHANGE_ME"
  JWT_SECRET_KEY: "CHANGE_ME"
  ADMIN_EMAIL: "CHANGE_ME"
  ADMIN_PASSWORD: "CHANGE_ME"
  ADMIN_NAME: "CHANGE_ME"
